OPENAI_API_KEY=EMPTY
OPENAI_BASE_URL=http://127.0.0.1:9000/v1
MINICACHE_MODEL=qwen3-32b-fp8
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional service controls.
GENCACHE_FALLBACK_ENABLE_THINKING=false
GENCACHE_GPTCACHE_SIMILARITY_THRESHOLD=0.95
GENCACHE_CODEGEN_FALLBACK=true
GENCACHE_FALLBACK_CONCURRENCY=1
